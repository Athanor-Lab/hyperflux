# Maintainer: xAlcahest <xAlcahest@users.noreply.github.com>

pkgname=hyperflux-git
pkgver=1.0.0
pkgrel=1
pkgdesc='Lightweight CLI download accelerator (fork of Axel) with URL range/list expansion'
arch=('x86_64' 'aarch64')
url='https://github.com/Athanor-Lab/hyperflux'
license=('GPL-2.0-or-later')
depends=('openssl')
makedepends=('git' 'autoconf-archive' 'gettext' 'pkgconf' 'txt2man')
provides=('hyperflux')
conflicts=('hyperflux')
source=("$pkgname::git+https://github.com/Athanor-Lab/hyperflux.git")
sha256sums=('SKIP')

pkgver() {
	cd "$srcdir/$pkgname"
	local desc
	# Strip a leading v, then convert git describe into the AUR-recommended format.
	if desc=$(git describe --long --tags 2>/dev/null); then
		printf '%s' "$desc" | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
	else
		printf '0.r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
	fi
}

build() {
	cd "$srcdir/$pkgname"
	autoreconf -fi || ./autogen.sh
	./configure --prefix=/usr --disable-Werror
	make
}

package() {
	cd "$srcdir/$pkgname"
	make DESTDIR="$pkgdir" install
	install -Dm644 doc/fluxrc.example "$pkgdir/usr/share/doc/$pkgname/fluxrc.example"
}
