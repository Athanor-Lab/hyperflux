# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# C sources use tab indentation with K&R braces.
[*.{c,h}]
indent_style = tab

[*.{yml,yaml,md}]
indent_style = space
indent_size = 2

# Keep gettext catalogs readable; msgfmt is whitespace-sensitive.
[*.po]
indent_style = space
trim_trailing_whitespace = false
